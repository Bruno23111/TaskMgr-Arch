{
  "info": {
    "_postman_id": "8266b1ee-2493-43b7-970b-b1a4e95e5738",
    "name": "TaskMgr - Clean Architecture",
    "description": "Collection funcional para a API TaskMgr Clean Architecture. Execute na ordem numerada; os scripts salvam token, IDs e versões no Environment selecionado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5278" },
    { "key": "token", "value": "" },
    { "key": "gestorEmail", "value": "gestor@teste.local" },
    { "key": "gestorSenha", "value": "SenhaSegura123!" },
    { "key": "usuarioEmail", "value": "usuario.e2e@teste.local" },
    { "key": "usuarioSenha", "value": "SenhaSegura123!" },
    { "key": "statusPendenteId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "statusEmAndamentoId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "statusConcluidaId", "value": "33333333-3333-3333-3333-333333333333" }
  ],
  "item": [
    {
      "name": "01 - Infraestrutura e autenticação",
      "item": [
        { "name": "Health check", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }] },
        { "name": "Login gestor", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{gestorEmail}}\",\n  \"senha\": \"{{gestorSenha}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.environment.set('token', body.accessToken);", "pm.collectionVariables.set('token', body.accessToken);"] } }] },
        { "name": "Login usuário", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{usuarioEmail}}\",\n  \"senha\": \"{{usuarioSenha}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.environment.set('tokenUsuario', body.accessToken);"] } }] }
      ]
    },
    {
      "name": "02 - Status",
      "item": [
        { "name": "Listar status", "request": { "method": "GET", "url": "{{baseUrl}}/status" } },
        { "name": "Obter status", "request": { "method": "GET", "url": "{{baseUrl}}/status/{{statusPendenteId}}" } },
        { "name": "Criar status", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"BLOQ_{{$timestamp}}\",\n  \"nome\": \"Bloqueada\",\n  \"categoria\": \"EM_ANDAMENTO\"\n}" }, "url": "{{baseUrl}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const body = pm.response.json(); pm.environment.set('statusCustomId', body.id); pm.environment.set('versaoStatusCustom', body.versao);"] } }] },
        { "name": "Atualizar status customizado", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Bloqueada - revisada\",\n  \"versao\": {{versaoStatusCustom}}\n}" }, "url": "{{baseUrl}}/status/{{statusCustomId}}" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoStatusCustom', body.versao);"] } }] },
        { "name": "Excluir status customizado", "request": { "method": "DELETE", "url": "{{baseUrl}}/status/{{statusCustomId}}?versao={{versaoStatusCustom}}" } }
      ]
    },
    {
      "name": "03 - Responsáveis",
      "item": [
        { "name": "Criar responsável usuário", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Usuário E2E\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"senha\": \"{{usuarioSenha}}\",\n  \"papel\": \"Usuario\"\n}" }, "url": "{{baseUrl}}/responsaveis" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const body = pm.response.json(); pm.environment.set('responsavelId', body.id); pm.environment.set('versaoResponsavel', body.versao);"] } }] },
        { "name": "Listar responsáveis", "request": { "method": "GET", "url": "{{baseUrl}}/responsaveis" } },
        { "name": "Obter responsável", "request": { "method": "GET", "url": "{{baseUrl}}/responsaveis/{{responsavelId}}" } },
        { "name": "Atualizar responsável", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Usuário E2E Atualizado\",\n  \"email\": \"{{usuarioEmail}}\",\n  \"papel\": \"Usuario\",\n  \"versao\": {{versaoResponsavel}}\n}" }, "url": "{{baseUrl}}/responsaveis/{{responsavelId}}" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoResponsavel', body.versao);"] } }] },
        { "name": "Desativar responsável (executar só no fim)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"versao\": {{versaoResponsavel}} }" }, "url": "{{baseUrl}}/responsaveis/{{responsavelId}}/desativacao" } },
        { "name": "Excluir responsável (executar só no fim)", "request": { "method": "DELETE", "url": "{{baseUrl}}/responsaveis/{{responsavelId}}?versao={{versaoResponsavel}}" } }
      ]
    },
    {
      "name": "04 - Projeto e tarefa — fluxo principal",
      "item": [
        { "name": "Criar projeto", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Projeto E2E {{$timestamp}}\",\n  \"descricao\": \"Validação via Postman\"\n}" }, "url": "{{baseUrl}}/projetos" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const body = pm.response.json(); pm.environment.set('projetoId', body.id); pm.environment.set('versaoProjeto', body.versao);"] } }] },
        { "name": "Listar projetos", "request": { "method": "GET", "url": "{{baseUrl}}/projetos?pagina=1&tamanho=20" } },
        { "name": "Obter projeto", "request": { "method": "GET", "url": "{{baseUrl}}/projetos/{{projetoId}}" } },
        { "name": "Atualizar projeto", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Projeto E2E atualizado\",\n  \"descricao\": \"Descrição atualizada\",\n  \"versao\": {{versaoProjeto}}\n}" }, "url": "{{baseUrl}}/projetos/{{projetoId}}" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoProjeto', body.versao);"] } }] },
        { "name": "Criar tarefa", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"projetoId\": \"{{projetoId}}\",\n  \"titulo\": \"Validar fluxo E2E\",\n  \"descricao\": \"Tarefa criada pelo Postman\"\n}" }, "url": "{{baseUrl}}/tarefas" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 201', () => pm.response.to.have.status(201));", "const body = pm.response.json(); pm.environment.set('tarefaId', body.id); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Listar tarefas do projeto", "request": { "method": "GET", "url": "{{baseUrl}}/tarefas?projetoId={{projetoId}}&pagina=1&tamanho=20" } },
        { "name": "Obter tarefa", "request": { "method": "GET", "url": "{{baseUrl}}/tarefas/{{tarefaId}}" } },
        { "name": "Atualizar tarefa", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Validar fluxo E2E atualizado\",\n  \"descricao\": \"Conteúdo atualizado\",\n  \"versao\": {{versaoTarefa}}\n}" }, "url": "{{baseUrl}}/tarefas/{{tarefaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Atribuir responsável", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"responsavelId\": \"{{responsavelId}}\",\n  \"versao\": {{versaoTarefa}}\n}" }, "url": "{{baseUrl}}/tarefas/{{tarefaId}}/responsavel" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Mover para em andamento", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"statusId\": \"{{statusEmAndamentoId}}\",\n  \"versao\": {{versaoTarefa}}\n}" }, "url": "{{baseUrl}}/tarefas/{{tarefaId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Concluir tarefa", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"statusId\": \"{{statusConcluidaId}}\",\n  \"versao\": {{versaoTarefa}}\n}" }, "url": "{{baseUrl}}/tarefas/{{tarefaId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('Tarefa concluída possui data', () => pm.expect(pm.response.json().concluidaEm).to.not.be.null);", "const body = pm.response.json(); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Reabrir como gestor", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"statusId\": \"{{statusPendenteId}}\",\n  \"versao\": {{versaoTarefa}}\n}" }, "url": "{{baseUrl}}/tarefas/{{tarefaId}}/status" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Remover responsável", "request": { "method": "DELETE", "url": "{{baseUrl}}/tarefas/{{tarefaId}}/responsavel?versao={{versaoTarefa}}" }, "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json(); pm.environment.set('versaoTarefa', body.versao);"] } }] },
        { "name": "Excluir tarefa", "request": { "method": "DELETE", "url": "{{baseUrl}}/tarefas/{{tarefaId}}?versao={{versaoTarefa}}" } },
        { "name": "Excluir projeto", "request": { "method": "DELETE", "url": "{{baseUrl}}/projetos/{{projetoId}}?versao={{versaoProjeto}}" } }
      ]
    }
  ]
}
